# Copia este archivo a .env y completa los valores.

EXPRESS_PORT=3000

# Origen(es) del cliente permitidos por CORS, separados por coma.
CLIENT_ORIGIN=http://localhost:5173

# URL pública del cliente (para construir los links de invitación).
APP_BASE_URL=https://app.thetavlo.app

# --- Firebase Admin (Service Account) ---
# Descarga el JSON de la service account desde Firebase Console >
# Configuración del proyecto > Cuentas de servicio.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Si pegas la private key en un .env de una sola línea, conserva los "\n" literales.
FIREBASE_PRIVATE_KEY=

# --- Resend (envío de correos de invitación) ---
RESEND_API_KEY=
INVITATION_EMAIL_FROM="TheTavlo <invitaciones@thetavlo.app>"
