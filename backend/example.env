# Copia este archivo a .env y completa los valores.

EXPRESS_PORT=3000

# Origen(es) del cliente permitidos por CORS, separados por coma.
CLIENT_ORIGIN=http://localhost:5173

# URL pública del cliente (para construir los links de invitación).
APP_BASE_URL=https://app.thetavlo.app

# --- Firebase Admin (Service Account) ---
# Codifica el JSON completo de la service account en base64 y pégalo aquí.
# Debe pertenecer al mismo proyecto que VITE_FIREBASE_PROJECT_ID del cliente.
FIREBASE_CRED=
# URL de Firebase Realtime Database usada por Firebase Admin.
FIREBASE_DATABASE_URL=

# --- Resend (envío de correos de invitación) ---
RESEND_API_KEY=
INVITATION_EMAIL_FROM="TheTavlo <invitaciones@thetavlo.app>"

# --- Google GenAI (sugerencias de emojis) ---
# Solo para Vertex AI: requiere credenciales ADC configuradas en el entorno.
GOOGLE_GENAI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=eu
