{
  "buildCommand": "pnpm --filter client build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": "/backend/api/index.ts"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}